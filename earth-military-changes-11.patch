From 9b6dfa1819d9d82625982f1c19f0fa1b09d74b96 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Mon, 21 Sep 2026 09:25:12 +0000
Subject: [PATCH] Add real favicon from the crest logo, shorten tab title to
 'Earth Military'

- Replace the missing/default vite.svg favicon with a badge version of the crest (dark rounded background + crest, generated at 16/32/192/512px plus a multi-size .ico and an apple-touch-icon)
- Page title shortened from 'Earth Kingdom Military Command' to 'Earth Military'
- Updated matching Open Graph/Twitter title and description to match
---
 index.html                  |  16 ++++++++++------
 public/apple-touch-icon.png | Bin 0 -> 43287 bytes
 public/favicon-16.png       | Bin 0 -> 697 bytes
 public/favicon-192.png      | Bin 0 -> 48418 bytes
 public/favicon-32.png       | Bin 0 -> 2184 bytes
 public/favicon-512.png      | Bin 0 -> 252514 bytes
 public/favicon.ico          | Bin 0 -> 8152 bytes
 7 files changed, 10 insertions(+), 6 deletions(-)
 create mode 100644 public/apple-touch-icon.png
 create mode 100644 public/favicon-16.png
 create mode 100644 public/favicon-192.png
 create mode 100644 public/favicon-32.png
 create mode 100644 public/favicon-512.png
 create mode 100644 public/favicon.ico

diff --git a/index.html b/index.html
index 0f27361..c6fcbca 100644
--- a/index.html
+++ b/index.html
@@ -2,21 +2,25 @@
 <html lang="en">
   <head>
     <meta charset="UTF-8" />
-    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
+    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
+    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
+    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
+    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
+    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
-    <title>Earth Kingdom Military Command</title>
+    <title>Earth Military</title>
 
     <!-- Open Graph / Discord embed -->
-    <meta property="og:title" content="Earth Kingdom Military Command" />
-    <meta property="og:description" content="Earth Kingdom Military Command" />
+    <meta property="og:title" content="Earth Military" />
+    <meta property="og:description" content="Earth Military" />
     <meta property="og:image" content="https://earthmilitary.bolt.host/og-image.png" />
     <meta property="og:url" content="https://earthmilitary.bolt.host" />
     <meta property="og:type" content="website" />
 
     <!-- Twitter Card (Discord also reads these as a fallback) -->
     <meta name="twitter:card" content="summary_large_image" />
-    <meta name="twitter:title" content="Earth Kingdom Military Command" />
-    <meta name="twitter:description" content="Earth Kingdom Military Command" />

+# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
+# NEVER commit the real value of this file. Copy this to .env and fill in real
+# values there; .env is gitignored.
+DISCORD_BOT_TOKEN=
+
+# Shared secret the website's Supabase edge functions must send in an
+# Authorization header to call this bot's HTTP API. Generate any long random
+# string for this (e.g. `openssl rand -hex 32`).
+BOT_API_SECRET=
+
+# Your Supabase project URL and service role key, so the bot can call back
+# into Supabase edge functions when something happens on Discord (a reaction,
+# a co-host claim button click).
+SUPABASE_URL=
+SUPABASE_SERVICE_ROLE_KEY=
+
+# Discord server + channel IDs (from your message)
+MAIN_SERVER_ID=1493716929649578220
+MAIN_EVENTS_CHANNEL_ID=1493717623962075377
+MILITARY_SERVER_ID=1544341603009953794
+MILITARY_COHOST_REQUEST_CHANNEL_ID=1545158031833039112
+
+# Role IDs used for role-gated poll voting
+SOLDIER_ROLE_ID=1493722834751717396
+CITIZEN_ROLE_ID=1493722878275747962
+PRIVATE_ROLE_ID=1493722852653011094
+
+# Port the bot's HTTP API listens on (Railway sets PORT automatically)
+PORT=3000

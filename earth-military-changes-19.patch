+    const eventId = url.searchParams.get("eventId");
+
+    if (!eventId) {
+      return new Response(
+        JSON.stringify({ error: "eventId is required" }),
+        { status: 400, headers: { ...corsHeaders, "Content-Type": "application/json" } }

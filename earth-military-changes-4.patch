From 698571b7197f4f1654de519b1d6347f3ec4aac75 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Fri, 18 Sep 2026 10:25:04 +0000
Subject: [PATCH] Set Discord/Open Graph embed image and metadata

- Add public/og-image.png: 1200x630 banner with the Earth Kingdom crest on a dark themed background
- Replace bolt.new placeholder og:image with the real site image
- Add og:title, og:description, og:url, og:type, and matching twitter: tags
---
 index.html          |  14 ++++++++++++--
 public/og-image.png | Bin 0 -> 307420 bytes
 2 files changed, 12 insertions(+), 2 deletions(-)
 create mode 100644 public/og-image.png

diff --git a/index.html b/index.html
index 7208ade..0f27361 100644
--- a/index.html
+++ b/index.html
@@ -5,9 +5,19 @@
     <link rel="icon" type="image/svg+xml" href="/vite.svg" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>Earth Kingdom Military Command</title>
-    <meta property="og:image" content="https://bolt.new/static/og_default.png" />
+
+    <!-- Open Graph / Discord embed -->
+    <meta property="og:title" content="Earth Kingdom Military Command" />
+    <meta property="og:description" content="Earth Kingdom Military Command" />
+    <meta property="og:image" content="https://earthmilitary.bolt.host/og-image.png" />
+    <meta property="og:url" content="https://earthmilitary.bolt.host" />
+    <meta property="og:type" content="website" />
+
+    <!-- Twitter Card (Discord also reads these as a fallback) -->
     <meta name="twitter:card" content="summary_large_image" />
-    <meta name="twitter:image" content="https://bolt.new/static/og_default.png" />
+    <meta name="twitter:title" content="Earth Kingdom Military Command" />
+    <meta name="twitter:description" content="Earth Kingdom Military Command" />
+    <meta name="twitter:image" content="https://earthmilitary.bolt.host/og-image.png" />
   </head>
   <body>
     <div id="root"></div>
diff --git a/public/og-image.png b/public/og-image.png
new file mode 100644
index 0000000000000000000000000000000000000000..5f80810630a4de2d242dedafce5c92ea24c919a1

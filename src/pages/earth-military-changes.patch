+          </div>
+          <div>
+            <label className="ek-label">Icon (emoji or symbol, fallback)</label>
+            <input value={icon} onChange={(e) => setIcon(e.target.value)} className="ek-input w-full" maxLength={10} />
+          </div>
+          <div>
+            <label className="ek-label flex items-center gap-1.5">
